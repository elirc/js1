{
  "name": "quality-audits",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:setup": "psql \"$DATABASE_URL\" -f server/db/schema.sql",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
